{
  "name": "geldar-scriptorium",
  "private": true,
  "description": "Scriptorium: the Geldar sovereign player kit (template, kit image, launcher).",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tests --noEmit",
    "test": "vitest run",
    "check:repo": "node tools/repo-checks/src/cli.ts",
    "check:template": "node tests/template/check.ts",
    "check:specs": "node tools/repo-checks/src/specs-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "ajv": "8.17.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
