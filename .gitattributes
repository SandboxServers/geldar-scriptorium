# Everything text is stored and checked out with LF, on every OS. Shell scripts,
# YAML, Dockerfiles and Gradle wrappers break or churn on CRLF, and Windows
# checkouts with core.autocrlf=true would otherwise convert them.
* text=auto eol=lf

# Windows batch files need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never converted or diffed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary

# Generated by pnpm; keep diffs readable and never hand-merge.
pnpm-lock.yaml -diff linguist-generated

# Append-only memory indexes: two PRs that each add a line keep both.
.claude/agent-memory/*/MEMORY.md merge=union
