#!/bin/bash
# The root wrapper of the fleet (F-05b): the one command the runner account may run, through sudo.
# Usage: geldar-fleet-run <verb> <id> [flags], or geldar-fleet-run check-login. Installed as
# /usr/local/sbin/geldar-fleet-run (root:root 0755) by install-wrapper.sh. Every argument is checked
# before anything runs; a bad one exits 2 with nothing started. The launcher verb then runs as the
# launcher account under a fixed environment: the caller's environment is never passed on.
# Exit codes: the launcher verb's code passes through; 2 usage, or a verb, id, flag or value that is
# refused; 6 check-secrets or check-login fails; 7 a step failed.
set -euo pipefail
# The search path and the locale are fixed first, so nothing below depends on the caller's.
readonly WRAP_PATH=/usr/local/bin:/usr/bin:/bin
PATH=$WRAP_PATH
export PATH
export LC_ALL=C
umask 022

# The constants below are the only paths and environment values the wrapper uses. The test copies
# the wrapper and rewrites these lines with sed; the installed values are the real ones.
readonly WRAP_LAUNCHER_USER=geldar
readonly WRAP_LAUNCHER_HOME=/home/geldar
readonly WRAP_DOCKER_HOST=unix:///var/run/docker.sock
readonly WRAP_STATE_DIR=/home/geldar/.local/state
readonly WRAP_RUNUSER=/usr/sbin/runuser
readonly WRAP_STAT=/usr/bin/stat
readonly WRAP_CHOWN=/usr/bin/chown
readonly WRAP_TOKEN_DIR=/etc/geldar/tokens
readonly WRAP_KEY_DIR=/etc/geldar/keys
readonly WRAP_DATA_DIR=/srv/geldar
# The shared login's path is set by F-10; this is the placeholder until F-10 names it.
readonly WRAP_LOGIN=/home/geldar/.claude/.credentials.json
readonly WRAP_VERBS="adopt deploy-key start restart stop remove upgrade player-status"
readonly WRAP_BUILTINS="check-secrets check-login"

die() {
  local code=$1
  shift
  echo "geldar-fleet-run: $*" >&2
  exit "$code"
}

# plain ARG: letters, digits, . _ / and - only, not empty, and no ".." anywhere. Every argument
# passes this before it is looked at again, so no shell metacharacter, space or newline gets in.
plain() {
  [[ $1 =~ ^[A-Za-z0-9._/-]+$ ]] || return 1
  [[ $1 != *..* ]]
}

# valid_id ID: ag-<name>-NN, 4 to 39 characters, no --, no trailing -.
valid_id() {
  local id=$1
  if [[ ! $id =~ ^ag-[a-z0-9-]+$ ]] || [ "${#id}" -lt 4 ] || [ "${#id}" -gt 39 ]; then
    return 1
  fi
  [[ $id != *--* ]] || return 1
  [[ $id != *- ]]
}

# allowed_flags VERB prints the flags the verb takes, space-separated. Nothing else is accepted.
allowed_flags() {
  case $1 in
    adopt) echo "--repo --token-file --data-dir --no-start" ;;
    remove | upgrade) echo "--yes" ;;
    player-status) echo "--kv" ;;
    *) echo "" ;;
  esac
}

# check_value FLAG VALUE ID: the value of a flag with a value must match its pattern for this id.
# An org or a name never starts with -, so a value cannot read as a flag.
check_value() {
  local flag=$1 value=$2 id=$3 re
  case $flag in
    --repo) re='^[A-Za-z0-9._][A-Za-z0-9._-]*/[A-Za-z0-9._][A-Za-z0-9._-]*$' ;;
    --token-file) re="^$WRAP_TOKEN_DIR/$id\.token\$" ;;
    --data-dir) re="^$WRAP_DATA_DIR/nvme-[deg]/players/player-$id\$" ;;
    *) die 2 "flag $flag takes no value" ;;
  esac
  [[ $value =~ $re ]] || die 2 "the value of $flag is refused"
}

# launcher_can_read FILE: true when the launcher account can read FILE and it is not empty.
launcher_can_read() {
  "$WRAP_RUNUSER" -u "$WRAP_LAUNCHER_USER" -- test -r "$1" || return 1
  "$WRAP_RUNUSER" -u "$WRAP_LAUNCHER_USER" -- test -s "$1"
}

# check_secrets ID: the token and the key exist, are not empty and are readable by the launcher.
# Nothing is printed about their contents.
check_secrets() {
  local id=$1 f
  for f in "$WRAP_TOKEN_DIR/$id.token" "$WRAP_KEY_DIR/$id"; do
    launcher_can_read "$f" || die 6 "a secret is missing, empty or unreadable by the launcher"
  done
}

# check_login: the shared login exists, is owned by the launcher account and has no group or world
# bits.
check_login() {
  local owner mode
  [ -f "$WRAP_LOGIN" ] || die 6 "the shared login is missing"
  owner=$("$WRAP_STAT" -c %U "$WRAP_LOGIN") || die 6 "the shared login cannot be read"
  mode=$("$WRAP_STAT" -c %a "$WRAP_LOGIN") || die 6 "the shared login cannot be read"
  [ "$owner" = "$WRAP_LAUNCHER_USER" ] || die 6 "the shared login is not owned by the launcher"
  [ $((8#$mode & 077)) -eq 0 ] || die 6 "the shared login has group or world bits"
}

verb=${1:-}
[ -n "$verb" ] || die 2 "usage: geldar-fleet-run <verb> <id> [flags]"
for arg in "$@"; do
  plain "$arg" || die 2 "an argument is refused"
done
shift
case " $WRAP_VERBS $WRAP_BUILTINS " in
  *" $verb "*) ;;
  *) die 2 "the verb is not allowed" ;;
esac

if [ "$verb" = check-login ]; then
  [ "$#" -eq 0 ] || die 2 "check-login takes no argument"
  check_login
  exit 0
fi
[ "$#" -ge 1 ] || die 2 "$verb needs an id"
id=$1
shift
valid_id "$id" || die 2 "the id is not valid"
if [ "$verb" = check-secrets ]; then
  [ "$#" -eq 0 ] || die 2 "check-secrets takes only an id"
  check_secrets "$id"
  exit 0
fi

flags=()
seen=" "
while [ "$#" -gt 0 ]; do
  flag=$1
  shift
  case " $(allowed_flags "$verb") " in
    *" $flag "*) ;;
    *) die 2 "flag $flag is not allowed for $verb" ;;
  esac
  # A flag given twice is refused, so the launcher never sees two values for one flag.
  case $seen in
    *" $flag "*) die 2 "flag $flag is repeated" ;;
  esac
  seen="$seen$flag "
  case $flag in
    --no-start | --yes | --kv)
      flags+=("$flag")
      ;;
    *)
      [ "$#" -ge 1 ] || die 2 "$flag needs a value"
      check_value "$flag" "$1" "$id"
      flags+=("$flag" "$1")
      shift
      ;;
  esac
done

# The launcher verb, started as the launcher account with exactly these four variables set.
launch=("$WRAP_RUNUSER" -u "$WRAP_LAUNCHER_USER" -- env -i "HOME=$WRAP_LAUNCHER_HOME"
  "PATH=$WRAP_PATH" "DOCKER_HOST=$WRAP_DOCKER_HOST" "XDG_STATE_HOME=$WRAP_STATE_DIR"
  geldar-play "$verb" "$id" "${flags[@]}")
cd "$WRAP_LAUNCHER_HOME/scriptorium" || die 7 "cannot enter the launcher clone"
if [ "$verb" != deploy-key ]; then
  exec "${launch[@]}"
fi
rc=0
"${launch[@]}" || rc=$?
if [ "$rc" -eq 0 ]; then
  key="$WRAP_STATE_DIR/$id/deploy-key"
  # The chown follows no symlink: a link in the id directory or on the key itself is refused.
  if [ -L "$WRAP_STATE_DIR/$id" ] || [ -L "$key" ]; then
    die 7 "the deploy key path holds a symlink"
  fi
  # Interim, until R-4 lands: the keeper reads the deploy key as uid 1002. Delete with R-4.
  "$WRAP_CHOWN" -h 1002:1002 "$key" || die 7 "chown of the deploy key failed"
fi
exit "$rc"
