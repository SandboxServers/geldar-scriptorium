# Pinned values for the runner install (fleet/runner/install-runner.sh). The script reads these
# lines as data and never sources this file. A value of FILL_ME stops the install with exit 5.
# The pins govern the first install only: the runner self-updates (D-FL-10, owner's choice; see
# fleet/runner/README.md, section Install).

# The self-hosted runner, linux-x64 tarball from the actions/runner release page (published
# 2026-10-26). The checksum is the release page's sha256 for that tarball.
RUNNER_VERSION=2.338.2
RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40
