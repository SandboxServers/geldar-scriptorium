# Pinned versions for the fleet VM bootstrap (fleet/bootstrap/). The scripts read these lines
# as data and never source this file. A value of FILL_ME stops a script with exit 5.

# git: the launcher clone needs 2.47.1 or newer (Debian 12 ships 2.39). The tarball is checked
# against kernel.org's signed sums before it is unpacked.
GIT_VERSION=2.47.1
GIT_URL=https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.47.1.tar.xz
GIT_SHA256=f3d8f9bb23ae392374e91cd9d395970dabc5b9c5ee72f39884613cd84a6ed310

# The launcher clone (the VM user's ~/scriptorium). The repo is private: the clone uses a
# read-only deploy key that the operator places on the VM, never a value in this file.
LAUNCHER_URL=https://github.com/SandboxServers/geldar-scriptorium.git
# Tag kit-v0.1.0-rc21, commit 79b28f7. Owner: scriptorium-orchestrator.
LAUNCHER_COMMIT=kit-v0.1.0-rc21
